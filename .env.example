# Copie para .env.local e preencha.

# Banco PostgreSQL (Neon, Supabase…). Sem ela, o app usa PGlite local em .data/
DATABASE_URL=

# Segredo para assinar a sessão (obrigatório em produção). Gere com: openssl rand -base64 32
AUTH_SECRET=

